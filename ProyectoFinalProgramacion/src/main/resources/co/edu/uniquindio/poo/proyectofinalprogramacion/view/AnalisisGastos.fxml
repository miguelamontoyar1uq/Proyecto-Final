<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" styleClass="vista" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalprogramacion.viewController.AnalisisGastosViewController">
   <Label maxWidth="Infinity" styleClass="titulo" text="Análisis de Gastos" />
   <HBox alignment="CENTER">
      <Button fx:id="btnEjecutar" mnemonicParsing="false" onAction="#ejecutarAnalisis" styleClass="boton-principal" text="Ejecutar análisis" />
   </HBox>
   <Label fx:id="lblMensaje" prefHeight="20.0" styleClass="mensaje-error" wrapText="true" />
   <HBox alignment="CENTER" spacing="24.0">
      <VBox maxWidth="Infinity" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <Label styleClass="tarjeta-etiqueta" text="Promedio" />
         <Label fx:id="lblPromedio" styleClass="tarjeta-valor" text="$ 0.00" />
      </VBox>
      <VBox maxWidth="Infinity" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <Label styleClass="tarjeta-etiqueta" text="Desviación estándar" />
         <Label fx:id="lblDesviacion" styleClass="tarjeta-valor" text="$ 0.00" />
      </VBox>
      <VBox maxWidth="Infinity" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <Label styleClass="tarjeta-etiqueta" text="Umbral atípico" />
         <Label fx:id="lblUmbral" styleClass="tarjeta-valor" text="$ 0.00" />
      </VBox>
   </HBox>
   <HBox spacing="24.0" VBox.vgrow="ALWAYS">
      <BarChart fx:id="chartGastos" animated="false" legendVisible="false" minHeight="200.0" title="Gastos del cliente" HBox.hgrow="ALWAYS">
         <xAxis>
            <CategoryAxis label="Monedero" />
         </xAxis>
         <yAxis>
            <NumberAxis label="Monto" />
         </yAxis>
      </BarChart>
      <VBox minWidth="460.0" prefWidth="460.0" spacing="8.0">
         <Label styleClass="subtitulo" text="Transacciones sospechosas" />
         <TableView fx:id="tblSospechosas" minHeight="150.0" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="colCodigo" text="Código" />
               <TableColumn fx:id="colFecha" text="Fecha" />
               <TableColumn fx:id="colTipo" text="Tipo" />
               <TableColumn fx:id="colMonto" text="Monto" />
            </columns>
         </TableView>
      </VBox>
   </HBox>
   <HBox alignment="CENTER">
      <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarAnalisis" styleClass="boton-principal" text="Limpiar" />
   </HBox>
</VBox>
