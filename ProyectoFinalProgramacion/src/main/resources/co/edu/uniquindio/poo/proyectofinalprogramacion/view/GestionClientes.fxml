<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" styleClass="vista" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalprogramacion.viewController.GestionClientesViewController">
   <Label maxWidth="Infinity" styleClass="titulo" text="Gestión de Clientes" />
   <GridPane hgap="20.0" vgap="10.0">
      <columnConstraints>
         <ColumnConstraints minWidth="150.0" prefWidth="150.0" />
         <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>
      <Label styleClass="etiqueta" text="Documento:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="txtDocumento" promptText="Solo números" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Label styleClass="etiqueta" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label styleClass="etiqueta" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtTelefono" promptText="Solo números" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label styleClass="etiqueta" text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <TextField fx:id="txtCorreo" promptText="nombre@dominio.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
   </GridPane>
   <Label fx:id="lblMensaje" prefHeight="20.0" styleClass="mensaje-error" wrapText="true" />
   <HBox alignment="CENTER" spacing="40.0">
      <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarCliente" styleClass="boton-principal" text="Actualizar Cliente" />
      <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#agregarCliente" styleClass="boton-principal" text="Agregar Cliente" />
   </HBox>
   <TextField fx:id="txtBuscar" promptText="Buscar por documento o nombre..." />
   <TableView fx:id="tblClientes" minHeight="150.0" VBox.vgrow="ALWAYS">
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <columns>
         <TableColumn fx:id="colDocumento" text="Documento" />
         <TableColumn fx:id="colNombre" text="Nombre" />
         <TableColumn fx:id="colTelefono" text="Teléfono" />
         <TableColumn fx:id="colCorreo" text="Correo" />
         <TableColumn fx:id="colRango" text="Rango" />
         <TableColumn fx:id="colPuntos" text="Puntos" />
      </columns>
   </TableView>
   <HBox alignment="CENTER" spacing="40.0">
      <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarFormulario" styleClass="boton-principal" text="Limpiar" />
      <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarCliente" styleClass="boton-peligro" text="Eliminar" />
   </HBox>
</VBox>
