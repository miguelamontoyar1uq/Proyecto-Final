<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" styleClass="vista" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalprogramacion.viewController.GestionMonederosViewController">
   <Label maxWidth="Infinity" styleClass="titulo" text="Gestión de Monederos" />
   <GridPane hgap="20.0" vgap="10.0">
      <columnConstraints>
         <ColumnConstraints minWidth="210.0" prefWidth="210.0" />
         <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>
      <Label styleClass="etiqueta" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="txtNombre" promptText="Ej: Ahorros viaje" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Label styleClass="etiqueta" text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <ComboBox fx:id="cmbTipo" maxWidth="Infinity" onAction="#cambiarTipo" promptText="Ahorros o Gastos diarios" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label styleClass="etiqueta" text="Saldo inicial:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtSaldoInicial" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label fx:id="lblMeta" managed="false" styleClass="etiqueta" text="Meta de ahorro:" visible="false" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <TextField fx:id="txtMetaAhorro" managed="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <Label fx:id="lblLimite" managed="false" styleClass="etiqueta" text="Límite diario:" visible="false" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <TextField fx:id="txtLimiteDiario" managed="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <Label fx:id="lblUmbral" managed="false" styleClass="etiqueta" text="Umbral de saldo bajo:" visible="false" GridPane.columnIndex="0" GridPane.rowIndex="5" />
      <TextField fx:id="txtUmbralSaldoBajo" managed="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
   </GridPane>
   <Label fx:id="lblMensaje" prefHeight="20.0" styleClass="mensaje-error" wrapText="true" />
   <HBox alignment="CENTER" spacing="40.0">
      <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarMonedero" styleClass="boton-principal" text="Actualizar Monedero" />
      <Button fx:id="btnCrear" mnemonicParsing="false" onAction="#crearMonedero" styleClass="boton-principal" text="Crear Monedero" />
   </HBox>
   <TableView fx:id="tblMonederos" minHeight="150.0" VBox.vgrow="ALWAYS">
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <columns>
         <TableColumn fx:id="colCodigo" text="Código" />
         <TableColumn fx:id="colNombre" text="Nombre" />
         <TableColumn fx:id="colTipo" text="Tipo" />
         <TableColumn fx:id="colSaldo" text="Saldo" />
      </columns>
   </TableView>
   <HBox alignment="CENTER" spacing="40.0">
      <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarFormulario" styleClass="boton-principal" text="Limpiar" />
      <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarMonedero" styleClass="boton-peligro" text="Eliminar" />
   </HBox>
</VBox>
