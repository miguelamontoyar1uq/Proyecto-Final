<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" styleClass="vista" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalprogramacion.viewController.NotificacionesViewController">
   <Label maxWidth="Infinity" styleClass="titulo" text="Notificaciones" />
   <HBox alignment="BOTTOM_LEFT" spacing="20.0">
      <VBox spacing="4.0" HBox.hgrow="ALWAYS">
         <Label styleClass="etiqueta" text="Tipo:" />
         <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Todos" />
      </VBox>
      <VBox spacing="4.0" HBox.hgrow="ALWAYS">
         <Label styleClass="etiqueta" text="Canal:" />
         <ComboBox fx:id="cmbCanal" maxWidth="Infinity" promptText="Todos" />
      </VBox>
      <Button fx:id="btnFiltrar" mnemonicParsing="false" onAction="#filtrar" styleClass="boton-principal, boton-corto" text="Filtrar" />
   </HBox>
   <Label fx:id="lblMensaje" prefHeight="20.0" styleClass="mensaje-error" wrapText="true" />
   <TableView fx:id="tblNotificaciones" minHeight="150.0" VBox.vgrow="ALWAYS">
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <columns>
         <TableColumn fx:id="colFecha" text="Fecha" />
         <TableColumn fx:id="colTipo" text="Tipo" />
         <TableColumn fx:id="colCanal" text="Canal" />
         <TableColumn fx:id="colMensaje" text="Mensaje" />
      </columns>
   </TableView>
   <HBox alignment="CENTER" spacing="40.0">
      <Button fx:id="btnLimpiarFiltros" mnemonicParsing="false" onAction="#limpiarFiltros" styleClass="boton-principal" text="Limpiar filtros" />
      <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarNotificacion" styleClass="boton-peligro" text="Eliminar notificación" />
   </HBox>
</VBox>
