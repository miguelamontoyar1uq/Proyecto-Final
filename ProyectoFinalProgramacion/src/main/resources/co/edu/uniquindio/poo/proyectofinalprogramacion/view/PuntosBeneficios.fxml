<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-vista" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalprogramacion.viewController.PuntosBeneficiosViewController">
   <content>
      <VBox spacing="12.0" styleClass="vista">
         <Label maxWidth="Infinity" styleClass="titulo" text="Puntos y Beneficios" />
         <HBox alignment="CENTER" spacing="24.0">
            <VBox maxWidth="Infinity" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <Label styleClass="tarjeta-etiqueta" text="Puntos acumulados" />
               <Label fx:id="lblPuntos" styleClass="tarjeta-valor" text="0" />
            </VBox>
            <VBox maxWidth="Infinity" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <Label styleClass="tarjeta-etiqueta" text="Rango actual" />
               <Label fx:id="lblRango" styleClass="tarjeta-valor" text="—" />
            </VBox>
            <VBox maxWidth="Infinity" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <Label styleClass="tarjeta-etiqueta" text="Descuento de tarifa" />
               <Label fx:id="lblDescuento" styleClass="tarjeta-valor" text="0%" />
            </VBox>
         </HBox>
         <VBox spacing="6.0">
            <Label fx:id="lblProgreso" styleClass="etiqueta" text="Seleccione un cliente para ver su progreso" />
            <ProgressBar fx:id="pbRango" maxWidth="Infinity" prefHeight="18.0" progress="0.0" />
         </VBox>
         <Label styleClass="subtitulo" text="Catálogo de beneficios" />
         <TableView fx:id="tblBeneficios" minHeight="170.0" prefHeight="170.0">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="colNombre" text="Nombre" />
               <TableColumn fx:id="colDescripcion" text="Descripción" />
               <TableColumn fx:id="colPuntosRequeridos" text="Puntos requeridos" />
               <TableColumn fx:id="colDuracion" text="Duración" />
            </columns>
         </TableView>
         <HBox alignment="CENTER">
            <Button fx:id="btnCanjear" mnemonicParsing="false" onAction="#canjearBeneficio" styleClass="boton-principal" text="Canjear beneficio" />
         </HBox>
         <Label fx:id="lblMensaje" prefHeight="20.0" styleClass="mensaje-error" wrapText="true" />
         <TabPane minHeight="230.0" prefHeight="230.0" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Historial de puntos">
               <TableView fx:id="tblHistorialPuntos">
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                  <columns>
                     <TableColumn fx:id="colFechaPuntos" text="Fecha" />
                     <TableColumn fx:id="colMovimiento" text="Movimiento" />
                     <TableColumn fx:id="colPuntosMov" text="Puntos" />
                     <TableColumn fx:id="colTransaccion" text="Transacción asociada" />
                  </columns>
               </TableView>
            </Tab>
            <Tab text="Beneficios canjeados">
               <TableView fx:id="tblCanjeados">
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                  <columns>
                     <TableColumn fx:id="colNombreCanjeado" text="Nombre" />
                     <TableColumn fx:id="colFechaCanje" text="Fecha de canje" />
                     <TableColumn fx:id="colVigencia" text="Vigencia" />
                  </columns>
               </TableView>
            </Tab>
         </TabPane>
         <HBox alignment="CENTER">
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarSeleccion" styleClass="boton-principal" text="Limpiar selección" />
         </HBox>
      </VBox>
   </content>
</ScrollPane>
