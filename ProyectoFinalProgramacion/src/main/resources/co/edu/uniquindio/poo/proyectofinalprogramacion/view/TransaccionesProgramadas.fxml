<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" styleClass="vista" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalprogramacion.viewController.TransaccionesProgramadasViewController">
   <Label maxWidth="Infinity" styleClass="titulo" text="Transacciones Programadas" />
   <GridPane hgap="16.0" vgap="10.0">
      <columnConstraints>
         <ColumnConstraints minWidth="190.0" prefWidth="190.0" />
         <ColumnConstraints hgrow="ALWAYS" />
         <ColumnConstraints minWidth="190.0" prefWidth="190.0" />
         <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>
      <Label styleClass="etiqueta" text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <ComboBox fx:id="cmbTipo" maxWidth="Infinity" onAction="#cambiarTipo" promptText="Depósito o transferencia" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Label styleClass="etiqueta" text="Monto:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      <TextField fx:id="txtMonto" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="0" />
      <Label styleClass="etiqueta" text="Frecuencia:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <ComboBox fx:id="cmbFrecuencia" maxWidth="Infinity" promptText="Diaria, semanal o mensual" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label styleClass="etiqueta" text="Próxima ejecución:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
      <DatePicker fx:id="dpProximaEjecucion" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />
      <Label styleClass="etiqueta" text="Monedero origen:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <ComboBox fx:id="cmbMonederoOrigen" maxWidth="Infinity" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label fx:id="lblMonederoDestino" managed="false" styleClass="etiqueta" text="Monedero destino:" visible="false" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      <ComboBox fx:id="cmbMonederoDestino" managed="false" maxWidth="Infinity" promptText="Seleccione" visible="false" GridPane.columnIndex="3" GridPane.rowIndex="2" />
   </GridPane>
   <Label fx:id="lblMensaje" prefHeight="20.0" styleClass="mensaje-error" wrapText="true" />
   <HBox alignment="CENTER" spacing="40.0">
      <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarProgramacion" styleClass="boton-principal" text="Actualizar" />
      <Button fx:id="btnProgramar" mnemonicParsing="false" onAction="#programarTransaccion" styleClass="boton-principal" text="Programar" />
   </HBox>
   <TableView fx:id="tblProgramadas" minHeight="150.0" VBox.vgrow="ALWAYS">
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <columns>
         <TableColumn fx:id="colCodigo" text="Código" />
         <TableColumn fx:id="colTipo" text="Tipo" />
         <TableColumn fx:id="colMonto" text="Monto" />
         <TableColumn fx:id="colFrecuencia" text="Frecuencia" />
         <TableColumn fx:id="colProxima" text="Próxima ejecución" />
         <TableColumn fx:id="colEstado" text="Estado" />
      </columns>
   </TableView>
   <HBox alignment="CENTER" spacing="30.0">
      <Button fx:id="btnAlternar" mnemonicParsing="false" onAction="#alternarEstado" styleClass="boton-principal" text="Activar / Pausar" />
      <Button fx:id="btnProcesar" mnemonicParsing="false" onAction="#procesarPendientes" styleClass="boton-principal" text="Procesar pendientes" />
      <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProgramacion" styleClass="boton-peligro" text="Eliminar" />
   </HBox>
</VBox>
